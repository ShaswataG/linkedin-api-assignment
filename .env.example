# Both values come from ONE authenticated LinkedIn session in your browser.
# Use a dedicated, non-primary account: this project carries real ban risk.

# The Cookie header value. Only these two cookies are required.
# Take them from DevTools > Application > Cookies > https://www.linkedin.com
# Keep the double quotes around the JSESSIONID value exactly as shown.
LINKEDIN_SESSION_COOKIE=li_at=AQEDA...; JSESSIONID="ajax:1234567890123456789"

# The JSESSIONID value WITHOUT the surrounding quotes. Must match the
# JSESSIONID above or LinkedIn rejects every request with 403.
LINKEDIN_CSRF_TOKEN=ajax:1234567890123456789

PORT=3000
CACHE_TTL_HOURS=48
RATE_LIMIT_PER_MINUTE=5
# Minimum gap between outbound calls to LinkedIn. Lower = faster, riskier.
UPSTREAM_MIN_INTERVAL_MS=1200
